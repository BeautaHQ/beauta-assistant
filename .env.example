# beauta-voice. Copy to .env and fill in.
#
# Only what differs from the defaults in src/config.ts. A setting that matches
# its default is noise: it looks like a decision, and it goes stale quietly when
# the default moves.

# Required. No default, and the service refuses to start without it.
PUBLIC_URL=https://your-tunnel.trycloudflare.com
OPENAI_API_KEY=
DATABASE_URL=

# Local only. Lets a hand-made request through a tunnel that carries no Twilio
# signature. Never set this in a deployed environment: leave it out and the
# default protects /incoming.
VERIFY_TWILIO_SIGNATURE=false

# Default is gpt-4o.
OPENAI_MODEL=gpt-5.6-luna

# The salon to fall back on when the dialled number names none. Defaults to 0,
# which is no salon at all.
ORGANIZATION_ID=1

# The origins allowed to reach /api/v1/conversations from a browser.
CHAT_ORIGINS=http://localhost:3000

# Where a call goes when the number matches no salon. Unset: told and hung up.
FORWARD_UNKNOWN_TO=

# Where uploaded images are served from. Without it the salon's reference
# photos are found but never shown — only the S3 key is stored, and there is
# nowhere to point a browser at. Same values as beauta-api's.
CDN_BEAUTA_URL=https://cdn.beauta.co
CDN_AURABEA_URL=https://cdn.aurabea.co
