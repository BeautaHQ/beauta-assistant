PORT=3003

PUBLIC_URL=https://voice.beauta.co

# From Twilio Console; used to verify webhooks really came from Twilio.
TWILIO_AUTH_TOKEN=

# Only for local tunnels. Never false in a deployed environment.
VERIFY_TWILIO_SIGNATURE=true

GREETING=Hello, thanks for calling. One moment please.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Spoken language for transcription and the voice, e.g. en-AU / en-US.
LANGUAGE=en-AU

# Bookings and availability come from here.
BEAUTA_API_URL=http://localhost:3001
# Which salon this phone number answers for.
ORGANIZATION_ID=
TIMEZONE=Australia/Sydney

DATABASE_URL="postgresql://user:password@localhost:5432/beauta-dev?schema=public"

ENABLE_CHAT_API=false
CHAT_ORIGINS=https://book.beauta.co

# Prisma Migrate connects through this, Prisma Client does not. It points at
# nothing on purpose: beauta-api owns the schema, and no migration may be run
# from here. Do not repair it.
BEAUTA_VOICE_MUST_NOT_MIGRATE="postgresql://blocked:blocked@127.0.0.1:1/blocked?schema=blocked"
