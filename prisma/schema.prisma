// Current points balance per customer (1:1 with Customer). Kept as a separate
// table so balance reads/writes don't touch the Customer row, and so loyalty
// features (tiers, expiry, etc.) can extend here later.
model CustomerPoint {
  id         Int @id @default(autoincrement())
  customerId Int @unique @map("customer_id")
  balance    Int @default(0) @map("balance")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_point")
}

// Append-only history of every point change. `points` is always a positive
// amount; `type` (ADD/DEDUCT) carries the direction. `balanceAfter` snapshots
// the resulting balance for easy auditing without replaying the whole ledger.
model CustomerPointTransaction {
  id           Int                  @id @default(autoincrement())
  customerId   Int                  @map("customer_id")
  type         PointTransactionType
  points       Int                  @map("points")
  balanceAfter Int                  @map("balance_after")
  note         String?              @map("note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   Customer                 @relation(fields: [customerId], references: [id])
  redemption CustomerPointRedemption? @relation("PointRedemptionDebit")
  refundFor  CustomerPointRedemption? @relation("PointRedemptionRefund")

  @@index([customerId])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@map("customer_point_transaction")
}

// A point-redemption event: the customer spends points in exchange for a
// reward/discount. Each redemption is backed by one DEDUCT entry in
// customer_point_transaction (the ledger movement), linked 1:1 below. `points`
// is the positive amount spent; `value` is the monetary value granted for it.
// Kept minimal on purpose — extend with reward/booking references later.
model CustomerPointRedemption {
  id                  Int                           @id @default(autoincrement())
  customerId          Int                           @map("customer_id")
  bookingId           Int?                          @map("booking_id")
  transactionId       Int                           @unique @map("transaction_id")
  refundTransactionId Int?                          @unique @map("refund_transaction_id")
  status              CustomerPointRedemptionStatus @default(ACTIVE)
  points              Int                           @map("points")
  value               Decimal                       @default(0) @map("value") @db.Decimal(10, 2)
  note                String?                       @map("note")
  refundedAt          DateTime?                     @map("refunded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer          Customer                  @relation(fields: [customerId], references: [id])
  booking           Booking?                  @relation(fields: [bookingId], references: [id])
  transaction       CustomerPointTransaction  @relation("PointRedemptionDebit", fields: [transactionId], references: [id])
  refundTransaction CustomerPointTransaction? @relation("PointRedemptionRefund", fields: [refundTransactionId], references: [id])

  @@index([customerId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@map("customer_point_redemption")
}

