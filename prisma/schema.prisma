  //
  // Two integers rather than a date because the only query is "whose birthday
  // is today": an equality match both columns, which the index below serves.
  // A DATE column would need EXTRACT on both sides and could not use one.
  birthDay   Int? @map("birth_day")
  birthMonth Int? @map("birth_month")

  @@unique([organizationId, phone])
