// A campaign starts from one of these. The HTML itself lives in Mailjet's
// template editor — this row is our pointer to it plus the bits we need to list
// and pick one without calling Mailjet.
//
// `organizationId` is null for the starter templates we ship, which every org
// can use but none can edit, so a salon's list is its own rows plus the null
// ones.
model MarketingTemplate {
  id             Int  @id @default(autoincrement())
  organizationId Int? @map("organization_id")

  name              String                    @db.VarChar(255)
  category          MarketingTemplateCategory @default(OTHER)
  // The Mailjet TemplateID passed to the Send API. Unique per org so the same
  // template can't be registered twice; the null-org rows share the global slot.
  mailjetTemplateId Int                       @map("mailjet_template_id")
  // Default subject for campaigns built from this template. Null means "use the
  // subject set on the Mailjet template itself".
  subject           String?                   @db.VarChar(255)
  // Which fields the salon has to fill in for THIS template, as a form spec the
  // app renders directly: [{ key, label, type, required, placeholder, help }].
  //
  // It lists only what a human supplies — the offer wording, a promo code. The
  // variables the API fills itself (customer name, salon details, booking link,
  // unsubscribe URL) are never in here, so they never reach the form.
  //
  // Json is jsonb on Postgres, which is what we want: these are read on every
  // campaign screen and never queried by key.
  variables         Json?
  // The rendered body, stored so the gallery can draw every template without a
  // Mailjet round trip each time. Mailjet's management API sits under a much
  // lower rate limit than the send API, and one salon opening the page would
  // otherwise cost one call per template.
  //
  // This is a copy, and it is safe to be one: the HTML is authored in the
  // beauta-template repo and pushed to both places by the same upload. Editing
  // a template in Mailjet's own editor is what would make it stale — re-run the
  // upload after doing that. Null falls back to fetching from Mailjet.
  previewHtml       String?                   @map("preview_html") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?       @relation(fields: [organizationId], references: [id])
  campaigns    MarketingCampaign[]

  @@unique([organizationId, mailjetTemplateId])
  @@index([organizationId, category])
  @@map("marketing_template")
}

// One blast.
//
// `mailjetTemplateId` is copied off the template rather than read through the
// relation: the salon may later point that template row somewhere else or
// archive it, and a sent campaign has to keep saying which Mailjet template
// actually went out.
model MarketingCampaign {
  id             Int  @id @default(autoincrement())
  organizationId Int  @map("organization_id")
  templateId     Int? @map("template_id")

  name              String  @db.VarChar(255)
  mailjetTemplateId Int     @map("mailjet_template_id")
  subject           String? @db.VarChar(255)
  // Campaign-level template variables (promo copy, CTA link, image URLs…).
  // Per-recipient ones (customer name, unsubscribe link) are merged at send.
  variables         Json?
  // Shown as the sender name so the inbox reads "Luxe Nails", not "Beauta".
  // Snapshotted here because the salon can rename itself afterwards.
  fromName          String? @map("from_name") @db.VarChar(255)
  replyTo           String? @map("reply_to")

  status   MarketingCampaignStatus @default(DRAFT)
  // The filter the audience was resolved from, kept so the salon can see who a
  // past campaign went to without re-running a query that would now answer
  // differently.
  audience Json?

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  // Denormalised so the campaigns list never aggregates the recipient table.
  totalCount  Int @default(0) @map("total_count")
  sentCount   Int @default(0) @map("sent_count")
  failedCount Int @default(0) @map("failed_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                 @relation(fields: [organizationId], references: [id])
  template     MarketingTemplate?           @relation(fields: [templateId], references: [id])
  recipients   MarketingCampaignRecipient[]

  @@index([organizationId, status, createdAt])
  @@map("marketing_campaign")
}

// The audience, frozen row by row the moment a send starts, and the per-address
// outcome afterwards.
//
// This table is what makes a send safe to resume: the unique on
// (campaignId, customerId) means a retry after a crash — or a double-clicked
// Send — can never mail the same customer twice, and the remaining work is
// always "the PENDING rows of this campaign".
model MarketingCampaignRecipient {
  id         Int    @id @default(autoincrement())
  campaignId Int    @map("campaign_id")
  customerId Int    @map("customer_id")
  email      String

  status           MarketingRecipientStatus @default(PENDING)
  mailjetMessageId String?                  @map("mailjet_message_id")
  sentAt           DateTime?                @map("sent_at") @db.Timestamptz(6)
  error            String?                  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id])

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@index([mailjetMessageId])
  @@map("marketing_campaign_recipient")
}

// Whether a customer still accepts marketing, kept off the Customer row the way
// CustomerPoint is. `unsubscribeToken` is what the unsubscribe link carries, so
// the URL never exposes a customer id and cannot be walked by incrementing it.
//
// Absence of a row means "not opted out" — consent is implied by the customer
// giving the salon their email, and the opt-out is what we have to honour.
model CustomerMarketingPreference {
  id         Int @id @default(autoincrement())
  customerId Int @unique @map("customer_id")

  optedOutAt       DateTime? @map("opted_out_at") @db.Timestamptz(6)
  unsubscribeToken String    @unique @map("unsubscribe_token")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_marketing_preference")
}

// Anonymous device-level tracking. beauta-org-app mints a UUID on first visit,
// stores it in localStorage, and reuses it forever. One row is recorded each
// time a human passes the hidden Turnstile check on the sign-up page.
model SignupVisit {
  id        Int      @id @default(autoincrement())
  deviceId  String   @map("device_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  language  String?  @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deviceId])
  @@index([createdAt])
  @@map("signup_visit")
}

// How a conversation with the AI receptionist ended. NO_ACTION covers the
// person who only had a question, or who went away partway.
enum ConversationOutcome {
  BOOKED
  WAITLISTED
  MESSAGE
  NO_ACTION
}

// How the customer reached the receptionist.
enum ConversationChannel {
  PHONE
  CHAT
}

// One conversation with the AI receptionist.
//
// Written by beauta-voice, not beauta-api: a conversation is long-lived and its
// transcript grows turn by turn while it is open. The salon needs to be able to
// read back what its receptionist actually said — an AI taking bookings that
// nobody can audit is not something a salon owner should have to trust blind.
//
// Identified by `publicId`, which this service mints, rather than by Twilio's
// call id. A phone call is one channel this can arrive on and chat is another;
// hanging the identity on the phone system's id would leave every chat needing
// a fake one.
model Conversation {
  id             Int                 @id @default(autoincrement()) @map("id")
  organizationId Int                 @map("organization_id")
  publicId       String              @unique @map("public_id")
  channel        ConversationChannel @default(PHONE)

  // Twilio's id for the call, when it was one. A link back to their records,
  // nothing more. Unique so a reconnecting socket finds the same row.
  callSid       String? @unique @map("call_sid")
  // Whoever is on the other end: a phone number, or whatever identifies a chat.
  fromNumber    String  @map("from_number")
  toNumber      String? @map("to_number")
  // On a forwarded call, the salon number the customer actually dialled.
  forwardedFrom String? @map("forwarded_from")

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  outcome ConversationOutcome @default(NO_ACTION)

  // Every turn in order: { role, text, at, intent }. One column rather than a
  // child table because a transcript is only ever read whole, with its
  // conversation.
  transcript   Json  @default("[]")
  // What the receptionist had pinned down at the end: service, date, time,
  // name. Kept even when nothing was booked — a conversation that fell over at
  // "which day?" is exactly the one worth looking at.
  bookingState Json? @map("booking_state")

  // Public ids rather than foreign keys: beauta-voice books over the HTTP API
  // and gets these back, never the row ids.
  bookingPublicId  String? @map("booking_public_id")
  waitlistPublicId String? @map("waitlist_public_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startedAt])
  @@map("conversation")
}
