model Booking {
  id                   Int                       @id @default(autoincrement()) @map("id")
  startTime            DateTime                  @map("start_time") @db.Timestamptz(6)
  endTime              DateTime                  @map("end_time") @db.Timestamptz(6)
  // SCHEDULED, COMPLETED, CANCELED or NO_SHOW — the four BookingResponseSchema
  // admits. The default used to be PENDING, which nothing else understood: any
  // caller who left `status` out of a public booking created a row that made
  // the salon's calendar fail to serialize for that whole day. Whether payment
  // is outstanding is bookingPaymentStatus's business, not this column's.
  status               String                    @default("SCHEDULED")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizationId       Int                       @map("organization_id")
  quantity             Int
  giftCardRedemptionId Int?                      @map("gift_card_redemption_id")
  publicId             String                    @unique @map("public_id")
  email                String?                   @map("email")
  firstName            String                    @map("first_name")
  lastName             String                    @map("last_name")
  phone                String                    @map("phone")
  totalPrice           Float                     @map("total_price")
  finalPrice           Float                     @map("final_price")
  amountPaid           Float?                    @map("amount_paid")
  bookingPaymentStatus BookingPaymentStatus      @default(UNPAID) @map("booking_payment_status")
  bookingMode          String                    @default("PUBLIC") @map("booking_mode")
  createdBy            String                    @default("OWNER") @map("created_by")
  updatedBy            String                    @default("OWNER") @map("updated_by")
  notes                String?                   @map("notes")
  customerNotes        String?                   @map("customer_notes")
  source               String                    @default("SYSTEM") @map("source")
  customerId           Int                       @map("customer_id")
  isReminded           Boolean                   @default(false) @map("is_reminded")
  reminderEnabled      Boolean                   @default(false) @map("reminder_enabled")
  isEmailReminded      Boolean                   @default(false) @map("is_email_reminded")
  bookingPaymentType   BookingPaymentType        @default(IN_PERSON) @map("booking_payment_type")
  customer             Customer                  @relation(fields: [customerId], references: [id])
  organization         Organization              @relation(fields: [organizationId], references: [id])
  bookingTasks         BookingTask[]
  giftCardRedemption   GiftCardRedemption?
  bookingEvents        BookingEvent[]
  notificationLogs     NotificationLog[]
  feedback             Feedback?
  issue                Issue?
  pointRedemptions     CustomerPointRedemption[]
  bookingImages        BookingImage[]

  @@index([startTime, endTime])
  @@index([organizationId, status, source, startTime])
  @@map("booking")
}

// Before/after photos attached to a booking. Many images per booking (multiple
// BEFORE + multiple AFTER), each row belongs to exactly one booking. We store
// only `s3Key` — the viewable URL is derived at read time (presigned GET for a
// private bucket, or CDN base from env + s3Key for a public one).
model BookingImage {
  id             Int              @id @default(autoincrement())
  bookingId      Int              @map("booking_id")
  organizationId Int              @map("organization_id")
  kind           BookingImageKind
  s3Key          String           @map("s3_key")
  uploadedBy     String?          @map("uploaded_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([bookingId, kind])
  @@index([organizationId])
  @@map("booking_image")
}

// One feedback per booking (1:1 via unique booking_id). Feedback does not hold
// a direct customer link — the customer is reached through the booking when
// needed. `mode` decides whether that identity is exposed by the API: REAL
// shows it, ANONYMOUS hides it (see FeedbackMapper).
model Feedback {
  id             Int          @id @default(autoincrement())
  bookingId      Int          @unique @map("booking_id")
  organizationId Int          @map("organization_id")
  mode           FeedbackMode @default(REAL)
  rating         Int          @map("rating")
  comment        String?      @map("comment")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking         @relation(fields: [bookingId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  images       FeedbackImage[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("feedback")
}

// Customer-submitted review photos attached to a feedback (one feedback → many
// photos). Only the s3Key is stored; the viewable URL is the public CDN base
// (env) joined with the key, so it can never drift. Uploaded anonymously by the
// customer via the public booking flow, hence no uploader column.
model FeedbackImage {
  id             Int      @id @default(autoincrement())
  feedbackId     Int      @map("feedback_id")
  organizationId Int      @map("organization_id")
  s3Key          String   @map("s3_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  feedback     Feedback     @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([feedbackId])
  @@index([organizationId])
  @@map("feedback_image")
}

// One customer-reported issue per booking (1:1 via unique booking_id). Unlike
// Feedback, an issue is always identified — the customer must be reachable for
// the salon to resolve it, so there is no anonymous mode. `status` tracks the
// lightweight OPEN → IN_PROGRESS → RESOLVED workflow. `resolutionNote` is a
// staff-only internal note and is never exposed to the customer.
model Issue {
  id             Int         @id @default(autoincrement())
  bookingId      Int         @unique @map("booking_id")
  organizationId Int         @map("organization_id")
  status         IssueStatus @default(OPEN)
  description    String      @map("description")
  resolutionNote String?     @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking      @relation(fields: [bookingId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  images       IssueImage[]

  @@index([organizationId, status])
  @@index([createdAt])
  @@map("issue")
}

// Photos a customer attaches to an issue (one issue → many photos). Mirrors
// FeedbackImage: only the s3Key is stored and the viewable URL is derived from
// the public CDN base (env) joined with the key. Uploaded via the public
// booking flow, hence no uploader column.
model IssueImage {
  id             Int      @id @default(autoincrement())
  issueId        Int      @map("issue_id")
  organizationId Int      @map("organization_id")
  s3Key          String   @map("s3_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([issueId])
  @@index([organizationId])
  @@map("issue_image")
}

// A salon asking the Beauta team to do something for them — set their account
// up, migrate their data in, or export it back out. Raised from the org portal
// and worked by us, so none of this is customer-facing.
//
// Attachments are kept as a plain array of S3 keys rather than a child table.
// They are write-once and only ever read back with their request, so a join
// table would buy ordering and per-row metadata that nothing here needs. The
// key is the whole record: the viewable URL is derived from the public CDN base
// at read time, so moving buckets never leaves stale rows behind.
model UserRequest {
  id             Int               @id @default(autoincrement())
  // The handle a salon quotes back at us. Six characters from an alphabet
  // with no look-alikes, because it gets read down a phone line and typed
  // into a search box; the autoincrement id stays internal.
  ref            String            @unique @db.VarChar(6)
  organizationId Int               @map("organization_id")
  // Who raised it, so the team can reply to a person rather than to a salon.
  userId         Int               @map("user_id")
  type           UserRequestType
  status         UserRequestStatus @default(PENDING)
  content        String
  imageKeys      String[]          @map("image_keys")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  // The list endpoint pages an organization's requests newest first, and
  // narrows by status; the composite covers both without a second index.
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("user_request")
}

// Versioned commission rate. A rule applies to one service, or to the whole org
// when serviceId is null (fallback/default rate). Rates are NEVER mutated in
// place: to change a rate you close the current row (effectiveTo = now) and
// insert a new one, so the full "what the rate was, and when" history is kept.
// A commission rate that applies to an optional staff and an optional item
// (a SERVICE or an ADDON). Both nullable, so one row can target any specificity:
//   staff + item  > item (any staff)  > staff (any item)  > org-wide default.
// Rates are versioned: changing one closes the current row (effectiveTo) and
// opens a new one, so historical rates are preserved. itemId is polymorphic
// (points at service OR addon per itemType) → no FK, resolved in app code.
model CommissionRule {
  id             Int                 @id @default(autoincrement())
  organizationId Int                 @map("organization_id")
  staffId        Int?                @map("staff_id")
  itemType       CommissionItemType? @map("item_type")
  itemId         Int?                @map("item_id")
  percentage     Decimal             @map("percentage") @db.Decimal(5, 2)
  effectiveFrom  DateTime            @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?           @map("effective_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  commissions  StaffCommission[]

  @@index([organizationId, staffId, itemType, itemId, effectiveFrom])
  @@map("commission_rule")
}

// Immutable snapshot of the commission a staff earned for one completed task.
// baseAmount, percentage and amount are FROZEN at completion time, so later
// CommissionRule changes never alter historical earnings. One row per task
// (booking_task_id is unique), which also makes recording idempotent.
model StaffCommission {
  id               Int              @id @default(autoincrement())
  organizationId   Int              @map("organization_id")
  staffId          Int              @map("staff_id")
  bookingTaskId    Int              @unique @map("booking_task_id")
  serviceId        Int?             @map("service_id")
  commissionRuleId Int?             @map("commission_rule_id")
  baseAmount       Decimal          @map("base_amount") @db.Decimal(10, 2)
  percentage       Decimal          @map("percentage") @db.Decimal(5, 2)
  amount           Decimal          @map("amount") @db.Decimal(10, 2)
  status           CommissionStatus @default(PENDING)
  completedAt      DateTime         @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  staff          Staff           @relation(fields: [staffId], references: [id])
  bookingTask    BookingTask     @relation(fields: [bookingTaskId], references: [id])
  service        Service?        @relation(fields: [serviceId], references: [id])
