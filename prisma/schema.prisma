generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Points nowhere on purpose. See above.
  directUrl = "postgresql://blocked:blocked@127.0.0.1:1/blocked"
}

