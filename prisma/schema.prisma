// Lifecycle of a customer-reported issue. Kept intentionally small: a new issue
// is OPEN, staff move it to IN_PROGRESS when they pick it up, and RESOLVED when
// handled. No reopen state — the customer would file a fresh issue instead.
enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum CommissionItemType {
  SERVICE
  ADDON
}

enum DailyJobType {
  SNAPSHOT
  COMMISSION
}

// What a salon is asking our team to do for them.
enum UserRequestType {
  ACCOUNT_SETUP
  DATA_MIGRATION
  DATA_EXPORT
}

// Where our team is up to on that request. The salon only ever submits; every
// move through this is ours.
enum UserRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// A marketing blast's lifecycle.
//
// SENDING is a lock, not a state anyone is meant to watch: it is held only
// while the batches are being handed to Mailjet, and the campaign closes as
// SENT or FAILED as soon as that finishes. Claiming it is what stops a
// double-clicked Send from starting two runs over the same recipients.
enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

// What a template is for. Drives the grouping in the template picker, so the
// salon scans a short list under "Birthday" instead of one long flat list.
enum MarketingTemplateCategory {
  BIRTHDAY
  PROMOTION
  SEASONAL
  ANNOUNCEMENT
  OTHER
}

// Per-recipient outcome, as far as the send call can tell.
//
// SENT means Mailjet accepted the message, which is all we know without an
// event webhook — there is deliberately no BOUNCED or OPENED here, because
// nothing in the system could ever set them. Add them back alongside the
// webhook that feeds them, not before.
enum MarketingRecipientStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            Int    @id @default(autoincrement())
  email         String @unique
  cognitoAuthId String @unique @map("cognito_auth_id")

  roleId Int?  @map("role_id")
  role   Role? @relation(fields: [roleId], references: [id])

  organizationId Int?          @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRequests UserRequest[]
  sessions     UserSession[]

  @@map("user")
}

/// One logged-in device. Cognito authenticates and hands out tokens but keeps
/// no session list of its own — there is no API to enumerate or revoke a single
/// login — so a row here is what makes "signed-in devices" and "sign out this
/// device" possible.
model UserSession {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cognito's `origin_jti`. It is minted alongside the refresh token and stays
  // the same across every access token refreshed from it, so it identifies one
  // login rather than one token.
  sessionKey String  @unique @map("session_key")
  // What makes a row stand for a device rather than a login: Cognito's
  // `device_key` when device tracking is on, otherwise the id the app sends in
  // `x-device-id`. Logging in again from the same device reuses its row.
  deviceKey  String? @map("device_key")

  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent") @db.Text
  deviceName String? @map("device_name") @db.VarChar(120)
  deviceType String? @map("device_type") @db.VarChar(16)
  browser    String? @db.VarChar(48)
  os         String? @db.VarChar(48)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  // Fixed at creation from the refresh token's lifetime, never extended: past
  // it the login is dead whatever this row says, and the prune sweeps it.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(24)

  // The listing wants one user's live sessions, most recently seen first.
  @@index([userId, revokedAt, lastSeenAt])
  @@index([expiresAt])
  @@map("user_session")
}

